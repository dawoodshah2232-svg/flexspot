# FlexSpot public Supabase connection
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side / Edge Function secrets (never expose in VITE_* variables)
SUPABASE_SERVICE_ROLE_KEY=

# Payment provider configuration
PAYMENT_PROVIDER=sandbox
BINANCE_PAY_MERCHANT_ID=
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=

# Optional on-chain processor/webhook values
PAYMENT_WEBHOOK_SECRET=
USDT_TRC20_ENABLED=false
USDT_BEP20_ENABLED=false

# Public app URL
VITE_APP_URL=https://flexspot.lol
