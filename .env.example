# FlexSpot public Supabase connection (enables LIVE leaderboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin dashboard PIN (required at build time — the admin gate refuses to
# render when this is unset; there is no default). Keep it secret: it is
# baked into the client bundle, so treat it as a light gate, not real auth.
VITE_ADMIN_PIN=

# Server-side / Edge Function secrets (never expose in VITE_* variables)
SUPABASE_SERVICE_ROLE_KEY=

# Payment provider configuration (Phase 1 = manual verification)
PAYMENT_PROVIDER=manual
BINANCE_PAY_MERCHANT_ID=
BINANCE_PAY_API_KEY=<redacted>
BINANCE_PAY_SECRET=<redacted>

# Optional on-chain processor/webhook values
PAYMENT_WEBHOOK_SECRET=<redacted>
USDT_TRC20_ENABLED=false
USDT_BEP20_ENABLED=false

# Public app URL (used for canonical + OG URLs in <title>/meta tags)
# Preview builds override this with the GitHub Pages URL.
VITE_APP_URL=https://flexspot.lol
VITE_SITE_URL=https://flexspot.lol

# Demo member seeding ('on' unless 'off'). The preview builds seed a demo
# dashboard account so the UI is explorable. PRODUCTION: set to 'off' so
# real members get the real login flow (email + password from approval email).
VITE_DEMO_SEED=on

# ── Email notifications (Resend) ──────────────────────────────────────
# Sign up at resend.com (free: 100 emails/day), create an API key, paste it
# here AND in the Vercel dashboard (or: npx vercel env add RESEND_API_KEY).
# Until this is set, the app runs fine — email calls just report "not configured".
RESEND_API_KEY=
# Verified sender, e.g. "FlexSpot <updates@flexspot.lol>".
# Verify flexspot.lol under resend.com/domains (3 DNS records) for production.
# Default (no DNS needed): FlexSpot <onboarding@resend.dev>
EMAIL_FROM=
# Where "new payment" admin alerts go (Dawood's inbox).
ADMIN_EMAIL=
# Server-side secrets for member sessions (generate: openssl rand -hex 32).
# Set via: printf '<value>' | npx vercel env add MEMBER_SECRET production
MEMBER_SECRET=
# Vercel KV (Storage → Create → KV, connect to this project) powers member
# logins + rate limits. Without it: approvals still work, logins wait.

# Google Analytics 4 (optional). Set to your measurement ID (G-XXXXXXXXXX)
# to enable GA4 with Consent Mode v2 + a cookie-consent banner.
# Leave empty to keep analytics fully disabled — no scripts load, no banner shows.
VITE_GA_MEASUREMENT_ID=
